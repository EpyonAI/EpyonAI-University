<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Pathfinder Career Compass — the MMORPG that turns real skills into real careers. AI Guides, gamified learning, and a path built just for you.">
  <title>Pathfinder Career Compass | Your Path Starts Here</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;0,900;1,700;1,900&family=DM+Mono:wght@400;500&family=Outfit:wght@300;400;600;700;900&display=swap" rel="stylesheet">
  <style>
    /* === TOKENS === */
    :root {
      --bg:      #050A06;
      --bg2:     #080F09;
      --card:    #0C140D;
      --card2:   #101A11;
      --accent:  #47A44A;
      --accent2: #5BC85E;
      --dark-g:  #236B2F;
      --gold:    #C9973A;
      --text:    #DDE8DE;
      --muted:   #5A7560;
      --border:  rgba(71,164,74,0.13);
      --glow:    rgba(71,164,74,0.18);
      --ff-head: 'Playfair Display', serif;
      --ff-mono: 'DM Mono', monospace;
      --ff-body: 'Outfit', sans-serif;
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }

    body {
      background: var(--bg);
      color: var(--text);
      font-family: var(--ff-body);
      font-size: 16px;
      line-height: 1.65;
      overflow-x: hidden;
    }

    a { color: inherit; text-decoration: none; }

    /* === PATH LINE === */
    .path-spine {
      position: fixed;
      left: clamp(16px, 3vw, 32px);
      top: 0; bottom: 0;
      width: 2px;
      pointer-events: none;
      z-index: 5;
    }
    .path-spine svg {
      width: 2px;
      height: 100%;
      position: absolute;
      top: 0; left: 0;
    }
    .path-line {
      stroke: var(--accent);
      stroke-width: 1.5;
      fill: none;
      stroke-dasharray: 8 6;
      opacity: 0.35;
    }
    .path-node {
      position: fixed;
      left: clamp(9px, 2.4vw, 25px);
      width: 10px; height: 10px;
      border-radius: 50%;
      background: var(--accent);
      box-shadow: 0 0 12px var(--accent);
      z-index: 6;
      transition: top 0.15s linear;
    }

    /* === NAV === */
    nav {
      position: fixed; top: 0; left: 0; right: 0; z-index: 100;
      display: flex; align-items: center; justify-content: space-between;
      padding: 1rem 2rem;
      background: rgba(5,10,6,0.88);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border-bottom: 1px solid var(--border);
    }
    .nav-brand {
      font-family: var(--ff-mono);
      font-size: 0.75rem;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: var(--text);
    }
    .nav-brand span { color: var(--accent); }
    .nav-links { display: flex; align-items: center; gap: 0.25rem; }
    .nav-links a {
      font-family: var(--ff-mono); font-size: 0.58rem; letter-spacing: 0.1em;
      text-transform: uppercase; color: var(--muted);
      padding: 0.4rem 0.75rem; border-radius: 999px;
      transition: color 0.2s, background 0.2s;
    }
    .nav-links a:hover { color: var(--accent); background: rgba(71,164,74,0.07); }
    .nav-cta {
      background: var(--dark-g) !important; color: #fff !important;
      font-weight: 500 !important;
    }
    .nav-cta:hover { background: var(--accent) !important; }

    /* === BUTTONS === */
    .btn {
      display: inline-flex; align-items: center; gap: 0.5rem;
      padding: 0.85rem 2rem;
      font-family: var(--ff-mono); font-size: 0.62rem;
      letter-spacing: 0.12em; text-transform: uppercase;
      cursor: pointer; border: none; border-radius: 0;
      transition: all 0.2s;
    }
    .btn-green { background: var(--accent); color: #050A06; font-weight: 500; }
    .btn-green:hover { background: var(--accent2); transform: translateY(-1px); }
    .btn-outline {
      background: transparent; color: var(--accent);
      border: 1px solid var(--accent);
    }
    .btn-outline:hover { background: rgba(71,164,74,0.07); }

    /* === HERO === */
    .hero {
      min-height: 100vh;
      display: grid;
      grid-template-columns: 1fr 1fr;
      align-items: center;
      max-width: 1200px;
      margin: 0 auto;
      padding: 8rem 2rem 5rem 5rem;
      gap: 3rem;
    }

    .hero-eyebrow {
      display: inline-flex; align-items: center; gap: 0.6rem;
      font-family: var(--ff-mono); font-size: 0.6rem;
      letter-spacing: 0.2em; text-transform: uppercase;
      color: var(--accent); margin-bottom: 1.75rem;
    }
    .eyebrow-dot {
      width: 6px; height: 6px; border-radius: 50%;
      background: var(--accent); box-shadow: 0 0 8px var(--accent);
      animation: pulseGlow 2s infinite;
    }
    @keyframes pulseGlow {
      0%,100% { opacity:1; transform:scale(1); box-shadow:0 0 8px var(--accent); }
      50%      { opacity:0.5; transform:scale(0.7); box-shadow:0 0 3px var(--accent); }
    }

    .hero-headline {
      font-family: var(--ff-head);
      font-size: clamp(3.5rem, 7vw, 6rem);
      font-weight: 900;
      line-height: 1;
      letter-spacing: -0.02em;
      margin-bottom: 1.5rem;
    }
    .hero-headline .word-your  { display: block; color: var(--muted); font-style: italic; font-size: 0.7em; }
    .hero-headline .word-path  { display: block; color: var(--text); }
    .hero-headline .word-starts { display: block; color: var(--text); }
    .hero-headline .word-here  { display: block; color: var(--accent); position: relative; }
    .hero-headline .hero-dot {
      display: inline-block;
      width: 14px; height: 14px;
      border-radius: 50%;
      background: var(--accent);
      vertical-align: middle;
      margin-left: 4px;
      margin-bottom: 8px;
      box-shadow: 0 0 20px var(--accent), 0 0 40px rgba(71,164,74,0.3);
      animation: pulseGlow 2s infinite;
    }

    .hero-sub {
      font-size: 1.05rem;
      color: var(--muted);
      max-width: 480px;
      line-height: 1.75;
      margin-bottom: 2.5rem;
      font-weight: 300;
    }
    .hero-sub strong { color: var(--accent); font-weight: 600; }

    .hero-actions { display: flex; gap: 1rem; flex-wrap: wrap; margin-bottom: 3rem; }

    .guide-label {
      font-family: var(--ff-mono); font-size: 0.6rem;
      letter-spacing: 0.15em; text-transform: uppercase;
      color: var(--muted); margin-bottom: 0.75rem;
    }
    .guide-avatars { display: flex; gap: 0.6rem; flex-wrap: wrap; }
    .guide-avatar {
      width: 52px; height: 52px; border-radius: 50%;
      overflow: hidden; border: 2px solid var(--border);
      cursor: default; transition: transform 0.3s, border-color 0.3s;
      position: relative;
    }
    .guide-avatar:hover {
      transform: translateY(-5px) scale(1.12);
      border-color: var(--accent);
      z-index: 5;
    }
    .guide-avatar img { width:100%; height:100%; object-fit:cover; }
    .guide-avatar .tip {
      position: absolute; bottom: -28px; left: 50%;
      transform: translateX(-50%);
      font-family: var(--ff-mono); font-size: 0.5rem;
      letter-spacing: 0.08em; text-transform: uppercase;
      color: var(--accent); white-space: nowrap;
      background: var(--card); padding: 2px 6px; border-radius: 2px;
      border: 1px solid var(--border);
      opacity: 0; transition: opacity 0.2s;
      pointer-events: none;
    }
    .guide-avatar:hover .tip { opacity: 1; }

    /* Hero right */
    .hero-right { position: relative; }
    .hero-img-frame {
      width: 100%; border-radius: 24px; overflow: hidden;
      border: 1px solid var(--border);
      box-shadow: 0 30px 80px -20px rgba(71,164,74,0.12);
    }
    .hero-img-frame img { width:100%; height:520px; object-fit:cover; display:block; }

    .float-badge {
      position: absolute;
      display: flex; align-items: center; gap: 0.75rem;
      background: rgba(12,20,13,0.95);
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 0.85rem 1.1rem;
      backdrop-filter: blur(12px);
    }
    .float-badge.bl { bottom: 14%; left: -8%; animation: floatY 5s ease-in-out infinite; }
    .float-badge.br { top: 18%; right: -6%; animation: floatY 5s ease-in-out infinite 2s; }
    @keyframes floatY {
      0%,100% { transform: translateY(0); }
      50%      { transform: translateY(-10px); }
    }
    .badge-icon {
      width: 34px; height: 34px; border-radius: 8px;
      display: flex; align-items: center; justify-content: center;
      background: rgba(71,164,74,0.1); color: var(--accent); flex-shrink: 0;
      font-size: 1.1rem;
    }
    .badge-text strong { display:block; font-size:0.84rem; color:var(--text); font-weight:600; }
    .badge-text span { font-size:0.68rem; color:var(--muted); }

    /* === SECTION COMMON === */
    section { padding: 6rem 2rem; }
    .sec-inner { max-width: 1100px; margin: 0 auto; }
    .sec-label {
      font-family: var(--ff-mono); font-size: 0.6rem;
      letter-spacing: 0.25em; text-transform: uppercase;
      color: var(--accent); margin-bottom: 1.25rem;
      display: flex; align-items: center; gap: 0.75rem;
    }
    .sec-label::after { content:''; flex:1; height:1px; background:var(--border); }
    h2.sec-heading {
      font-family: var(--ff-head);
      font-size: clamp(2rem, 5vw, 3.5rem);
      font-weight: 700; line-height: 1.08;
      letter-spacing: -0.02em; margin-bottom: 1.25rem;
    }
    h2.sec-heading em { font-style:italic; color:var(--accent); }
    .sec-sub {
      font-size: 1.02rem; color: var(--muted);
      max-width: 620px; line-height: 1.75;
      font-weight: 300;
    }

    /* === PIPELINE SECTION === */
    .pipeline-section { background: var(--bg2); border-top:1px solid var(--border); border-bottom:1px solid var(--border); }

    .pipeline {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      gap: 0;
      margin-top: 3.5rem;
      position: relative;
    }
    .pipeline::before {
      content: '';
      position: absolute;
      top: 38px; left: 10%; right: 10%;
      height: 1px;
      background: linear-gradient(to right, transparent, var(--accent), var(--accent), transparent);
      opacity: 0.25;
    }
    .pipe-step {
      display: flex; flex-direction: column; align-items: center;
      text-align: center; padding: 0 1rem;
      position: relative;
    }
    .pipe-icon {
      width: 76px; height: 76px;
      border-radius: 50%;
      background: var(--card);
      border: 1px solid var(--border);
      display: flex; align-items: center; justify-content: center;
      font-size: 1.75rem;
      margin-bottom: 1.25rem;
      position: relative; z-index: 1;
      box-shadow: 0 0 0 4px var(--bg2);
      transition: border-color 0.3s, box-shadow 0.3s;
    }
    .pipe-step:hover .pipe-icon {
      border-color: var(--accent);
      box-shadow: 0 0 0 4px var(--bg2), 0 0 20px rgba(71,164,74,0.2);
    }
    .pipe-arrow {
      position: absolute; top: 26px; right: -16px;
      color: var(--accent); opacity: 0.4; font-size: 1.5rem; z-index: 2;
    }
    .pipe-step:last-child .pipe-arrow { display: none; }
    .pipe-title {
      font-family: var(--ff-mono); font-size: 0.68rem;
      font-weight: 500; letter-spacing: 0.08em;
      text-transform: uppercase; color: var(--text);
      margin-bottom: 0.5rem;
    }
    .pipe-sources {
      font-size: 0.7rem; color: var(--muted);
      line-height: 1.6; font-weight: 300;
    }
    .pipe-highlight { color: var(--accent); font-weight: 500; }

    /* === MMORPG SECTION === */
    .mmorpg-section { background: var(--bg); }
    .mmorpg-split {
      display: grid; grid-template-columns: 1fr 1fr;
      gap: 4rem; align-items: center; margin-top: 2rem;
    }

    .comparison-table {
      border: 1px solid var(--border); border-radius: 16px; overflow: hidden;
    }
    .compare-row {
      display: grid; grid-template-columns: 1fr 1fr;
      border-bottom: 1px solid var(--border);
    }
    .compare-row:last-child { border-bottom: none; }
    .compare-cell {
      padding: 0.9rem 1.25rem;
      font-size: 0.85rem; font-weight: 300;
      display: flex; align-items: center; gap: 0.5rem;
    }
    .compare-cell.bad { color: var(--muted); border-right: 1px solid var(--border); }
    .compare-cell.good { color: var(--text); background: rgba(71,164,74,0.04); }
    .compare-header { background: var(--card); }
    .compare-header .compare-cell {
      font-family: var(--ff-mono); font-size: 0.6rem;
      letter-spacing: 0.12em; text-transform: uppercase; font-weight: 500;
    }
    .compare-header .compare-cell.bad { color: var(--muted); }
    .compare-header .compare-cell.good { color: var(--accent); }
    .badge-xp {
      display: inline-flex; align-items: center; gap: 0.4rem;
      background: rgba(71,164,74,0.12);
      border: 1px solid rgba(71,164,74,0.25);
      border-radius: 6px; padding: 0.2rem 0.6rem;
      font-family: var(--ff-mono); font-size: 0.62rem;
      color: var(--accent); letter-spacing: 0.08em;
    }

    .mmorpg-right { }
    .stat-cards {
      display: grid; grid-template-columns: 1fr 1fr;
      gap: 0.75rem; margin-top: 0;
    }
    .stat-card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 12px; padding: 1.5rem 1.25rem;
      transition: border-color 0.2s, transform 0.2s;
    }
    .stat-card:hover { border-color: var(--accent); transform: translateY(-3px); }
    .stat-icon { font-size: 1.75rem; margin-bottom: 0.75rem; }
    .stat-title {
      font-family: var(--ff-mono); font-size: 0.65rem;
      letter-spacing: 0.1em; text-transform: uppercase;
      color: var(--accent); margin-bottom: 0.4rem;
    }
    .stat-desc { font-size: 0.82rem; color: var(--muted); line-height: 1.55; font-weight: 300; }

    /* === GUIDES SECTION === */
    .guides-section { background: var(--bg2); border-top:1px solid var(--border); border-bottom:1px solid var(--border); }
    .guides-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1.25rem;
      margin-top: 3rem;
    }
    .guide-card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 16px; overflow: hidden;
      transition: border-color 0.2s, transform 0.2s;
    }
    .guide-card:hover { border-color: var(--accent); transform: translateY(-5px); }
    .guide-card-img {
      width: 100%; height: 220px;
      overflow: hidden; position: relative;
    }
    .guide-card-img img {
      width: 100%; height: 100%; object-fit: cover; object-position: top;
      display: block; transition: transform 0.5s;
    }
    .guide-card:hover .guide-card-img img { transform: scale(1.05); }
    .guide-card-body { padding: 1.25rem; }
    .guide-name {
      font-family: var(--ff-head); font-size: 1.2rem; font-weight: 700;
      color: var(--text); margin-bottom: 0.2rem;
    }
    .guide-role {
      font-family: var(--ff-mono); font-size: 0.58rem;
      letter-spacing: 0.12em; text-transform: uppercase;
      color: var(--accent); margin-bottom: 0.6rem;
    }
    .guide-spec { font-size: 0.82rem; color: var(--muted); line-height: 1.55; font-weight: 300; }

    /* === RESOURCES SECTION === */
    .resources-section { background: var(--bg); }
    .resource-grid {
      display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
      gap: 1rem; margin-top: 3rem;
    }
    .resource-card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 12px; padding: 1.5rem 1rem;
      text-align: center;
      transition: border-color 0.2s, background 0.2s;
    }
    .resource-card:hover { border-color: var(--accent); background: var(--card2); }
    .resource-icon { font-size: 2rem; margin-bottom: 0.75rem; }
    .resource-name {
      font-family: var(--ff-mono); font-size: 0.65rem;
      letter-spacing: 0.1em; text-transform: uppercase;
      color: var(--text); margin-bottom: 0.35rem;
    }
    .resource-desc { font-size: 0.72rem; color: var(--muted); line-height: 1.5; font-weight: 300; }

    /* === CTA SECTION === */
    .cta-section { background: var(--bg2); border-top: 1px solid var(--border); text-align: center; }
    .cta-inner { max-width: 700px; margin: 0 auto; }
    .cta-headline {
      font-family: var(--ff-head); font-size: clamp(2.5rem, 6vw, 4.5rem);
      font-weight: 900; line-height: 1; letter-spacing: -0.02em;
      margin-bottom: 1rem;
    }
    .cta-headline em { font-style: italic; color: var(--accent); }
    .cta-sub { font-size: 1rem; color: var(--muted); margin-bottom: 2.5rem; font-weight: 300; }
    .cta-actions { display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap; }

    /* === MARQUEE === */
    .marquee-strip {
      background: var(--card);
      border-top: 1px solid var(--border); border-bottom: 1px solid var(--border);
      padding: 1rem 0; overflow: hidden;
    }
    .marquee-inner {
      display: flex; gap: 3rem; white-space: nowrap;
      animation: marquee 25s linear infinite;
    }
    .marquee-item {
      font-family: var(--ff-mono); font-size: 0.65rem;
      letter-spacing: 0.18em; text-transform: uppercase; color: var(--muted);
      flex-shrink: 0;
    }
    .marquee-item span { color: var(--accent); margin: 0 1.5rem; }
    @keyframes marquee { from { transform: translateX(0); } to { transform: translateX(-50%); } }

    /* === FOOTER === */
    footer {
      border-top: 1px solid var(--border); padding: 2.5rem 2rem;
    }
    .foot-inner {
      max-width: 1100px; margin: 0 auto;
      display: flex; align-items: center; justify-content: space-between;
      gap: 1.5rem; flex-wrap: wrap;
    }
    .foot-brand { font-family: var(--ff-mono); font-size: 0.75rem; letter-spacing: 0.15em; text-transform: uppercase; color: var(--muted); }
    .foot-brand span { color: var(--accent); }
    .foot-links { display: flex; gap: 1.5rem; flex-wrap: wrap; }
    .foot-links a { font-size: 0.78rem; color: var(--muted); transition: color 0.2s; }
    .foot-links a:hover { color: var(--accent); }
    .foot-copy { font-size: 0.7rem; color: var(--muted); opacity: 0.45; }

    /* === RESPONSIVE === */
    @media (max-width: 900px) {
      .hero {
        grid-template-columns: 1fr; padding: 7rem 1.5rem 4rem 2.5rem;
        text-align: center;
      }
      .hero-right { display: none; }
      .guide-avatars { justify-content: center; }
      .hero-actions { justify-content: center; }
      .pipeline { grid-template-columns: 1fr; gap: 2rem; }
      .pipeline::before { display: none; }
      .pipe-arrow { display: none; }
      .mmorpg-split { grid-template-columns: 1fr; gap: 2.5rem; }
      .guides-grid { grid-template-columns: 1fr 1fr; }
      .path-spine, .path-node { display: none; }
    }
    @media (max-width: 600px) {
      .guides-grid { grid-template-columns: 1fr; }
      section { padding: 4rem 1.25rem; }
      .stat-cards { grid-template-columns: 1fr; }
      nav { padding: 0.75rem 1rem; }
      .nav-links { display: none; }
    }
    @media (prefers-reduced-motion: reduce) {
      * { transition: none !important; animation: none !important; }
    }
  </style>
</head>
<body>

  <!-- SCROLLING PATH SPINE -->
  <div class="path-spine">
    <svg viewBox="0 0 2 1000" preserveAspectRatio="none">
      <line class="path-line" x1="1" y1="0" x2="1" y2="1000"/>
    </svg>
  </div>
  <div class="path-node" id="pathNode"></div>

  <!-- NAV -->
  <nav>
    <div class="nav-brand">Path<span>finder</span></div>
    <div class="nav-links">
      <a href="#how">How It Works</a>
      <a href="#game">The Game</a>
      <a href="#guides">Your Guides</a>
      <a href="#resources">Resources</a>
      <a href="#join" class="nav-cta">Start Quest</a>
    </div>
  </nav>

  <!-- HERO -->
  <div class="hero">
    <div class="hero-left">
      <div class="hero-eyebrow">
        <span class="eyebrow-dot"></span>
        Epyon Foundation · Pathways Program
      </div>
      <h1 class="hero-headline">
        <span class="word-your">Your</span>
        <span class="word-path">Path</span>
        <span class="word-starts">Starts</span>
        <span class="word-here">Here<span class="hero-dot"></span></span>
      </h1>
      <p class="hero-sub">
        Not another LinkedIn Learning course. Pathfinder is an
        <strong>MMORPG-style career game</strong> that adapts to how you learn,
        pairs you with AI Guides, and turns real skills into real opportunities.
        <em style="font-style:normal;color:var(--text);">Free. For everyone.</em>
      </p>
      <div class="hero-actions">
        <a href="#join" class="btn btn-green">Start Your First Quest →</a>
        <a href="#how" class="btn btn-outline">See How It Works</a>
      </div>
      <p class="guide-label">Your AI Party — pick your guide</p>
      <div class="guide-avatars">
        <div class="guide-avatar">
          <img src="data:image/jpeg;base64," alt="Tempus Vale">
          <span class="tip">Tempus Vale</span>
        </div>
        <div class="guide-avatar">
          <img src="data:image/jpeg;base64," alt="Clearwater">
          <span class="tip">Clearwater</span>
        </div>
        <div class="guide-avatar">
          <img src="data:image/jpeg;base64,